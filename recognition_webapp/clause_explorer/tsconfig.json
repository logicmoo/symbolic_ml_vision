{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@app/*": ["./upstream/apps/workbench/src/*"]
    }
  },
  "include": ["*.ts", "upstream/**/*.ts", "upstream/**/*.tsx"]
}
