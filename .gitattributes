# Keep the repository Linux-friendly and deterministic across platforms.
# Git normalizes text files to LF unless a more specific rule overrides it.
* text=auto eol=lf

# Native Windows command scripts are the only CRLF exception.
# *.bat text eol=crlf
# *.cmd text eol=crlf
*.bat text eol=lf
*.cmd text eol=lf
*.py text eol=lf
*.pl text eol=lf

# Binary files must never be line-ending normalized.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
*.zip binary
*.gz binary
*.qlf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.ipynb text eol=lf
