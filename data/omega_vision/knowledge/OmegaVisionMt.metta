; OmegaVisionMt - vocabulary of the Omega Vision symbolic recognition pipeline.
; Generated by recognition_webapp/ontology.py (symbolic_ml_vision); regenerate there.
(isa OmegaVisionMt Microtheory)
(genlMt OmegaVisionMt BaseKB)
(ist OmegaVisionMt (isa VisualEntity Collection))
(ist OmegaVisionMt (comment VisualEntity "A tracked foreground object with a stable e# identity, persisted across frames by the clip tracker; reappearing objects re-bind to their remembered entity."))
(ist OmegaVisionMt (isa VisualEntityGroup Collection))
(ist OmegaVisionMt (comment VisualEntityGroup "A tracked group (g#/w#) of visual entities that the grouping rules accepted; identity persists across frames like entities."))
(ist OmegaVisionMt (isa ARC3Command Collection))
(ist OmegaVisionMt (comment ARC3Command "An ARC3-style user command token recorded in a frame's reserved state.json incoming_action: ACTION1..ACTION4 arrows, ACTION5/6, RESET. FRAME is a passive sampled advance and is NEVER a command."))
(ist OmegaVisionMt (isa FrameDesignator Collection))
(ist OmegaVisionMt (comment FrameDesignator "A frame(N) term naming a numbered frame of the recording being analysed."))
(ist OmegaVisionMt (isa TruthValue Collection))
(ist OmegaVisionMt (comment TruthValue "A NARS/PLN-style tv(strength, confidence) from counted evidence: strength = positive share, confidence = n/(n+1)."))
(ist OmegaVisionMt (isa Vector2D Collection))
(ist OmegaVisionMt (comment Vector2D "A dxy(dx, dy) pixel displacement per one-second frame step."))
(ist OmegaVisionMt (isa VisualEvent Collection))
(ist OmegaVisionMt (comment VisualEvent "An event/relation/state/action term asserted for one frame transition."))
(ist OmegaVisionMt (isa EventTypeDesignator Collection))
(ist OmegaVisionMt (comment EventTypeDesignator "The type key of a visual event as used by induction (e.g. moved, user_input(ACTION4), start(contact))."))
