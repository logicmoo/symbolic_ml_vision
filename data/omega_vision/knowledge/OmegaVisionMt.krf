;; OmegaVisionMt - vocabulary of the Omega Vision symbolic recognition pipeline.
;; Generated by recognition_webapp/ontology.py (symbolic_ml_vision); regenerate there.
;; Detected facts are observations of one recording; guesses carry tv(strength,
;; confidence) counted evidence and are hypotheses, never ground truth.

(in-microtheory BaseKB)
(isa OmegaVisionMt Microtheory)
(genlMt OmegaVisionMt BaseKB)
(comment OmegaVisionMt "Vocabulary of the Omega Vision symbolic recognition pipeline: per-transition visual events, episodic relations, states and exogenous user commands detected from recorded frames, plus the induction/abduction belief layer built over them. Frame-to-frame law: beliefs only ever accumulate from the transitions already seen; nothing is revealed before its frame.")

(in-microtheory OmegaVisionMt)

;; --- Collections ---
(isa VisualEntity Collection)
(comment VisualEntity "A tracked foreground object with a stable e# identity, persisted across frames by the clip tracker; reappearing objects re-bind to their remembered entity.")
(isa VisualEntityGroup Collection)
(comment VisualEntityGroup "A tracked group (g#/w#) of visual entities that the grouping rules accepted; identity persists across frames like entities.")
(isa ARC3Command Collection)
(comment ARC3Command "An ARC3-style user command token recorded in a frame's reserved state.json incoming_action: ACTION1..ACTION4 arrows, ACTION5/6, RESET. FRAME is a passive sampled advance and is NEVER a command.")
(isa FrameDesignator Collection)
(comment FrameDesignator "A frame(N) term naming a numbered frame of the recording being analysed.")
(isa TruthValue Collection)
(comment TruthValue "A NARS/PLN-style tv(strength, confidence) from counted evidence: strength = positive share, confidence = n/(n+1).")
(isa Vector2D Collection)
(comment Vector2D "A dxy(dx, dy) pixel displacement per one-second frame step.")
(isa VisualEvent Collection)
(comment VisualEvent "An event/relation/state/action term asserted for one frame transition.")
(isa EventTypeDesignator Collection)
(comment EventTypeDesignator "The type key of a visual event as used by induction (e.g. moved, user_input(ACTION4), start(contact)).")

;; --- Instantaneous visual events ---
(isa moved Predicate)
(arity moved 1)
(arg1Isa moved VisualEntity)
(comment moved "The entity translated between the previous and the current frame.")
(isa moved_right Predicate)
(arity moved_right 1)
(arg1Isa moved_right VisualEntity)
(comment moved_right "Direction-qualified movement: dominant displacement points right (+x). Definitional under moved.")
(isa moved_left Predicate)
(arity moved_left 1)
(arg1Isa moved_left VisualEntity)
(comment moved_left "Direction-qualified movement: dominant displacement points left (-x). Definitional under moved.")
(isa moved_up Predicate)
(arity moved_up 1)
(arg1Isa moved_up VisualEntity)
(comment moved_up "Direction-qualified movement: dominant displacement points up (-y). Definitional under moved.")
(isa moved_down Predicate)
(arity moved_down 1)
(arg1Isa moved_down VisualEntity)
(comment moved_down "Direction-qualified movement: dominant displacement points down (+y). Definitional under moved.")
(isa turned Predicate)
(arity turned 1)
(arg1Isa turned VisualEntity)
(comment turned "The entity's path heading changed between two consecutive displacement vectors (a path turn, not sprite rotation).")
(isa accelerated Predicate)
(arity accelerated 1)
(arg1Isa accelerated VisualEntity)
(comment accelerated "The entity's speed increased between consecutive one-second samples.")
(isa decelerated Predicate)
(arity decelerated 1)
(arg1Isa decelerated VisualEntity)
(comment decelerated "The entity's speed decreased between consecutive one-second samples.")
(isa bounce Predicate)
(arity bounce 1)
(arg1Isa bounce VisualEntity)
(comment bounce "Post-contact velocity reversal: the entity contacted something and reversed away.")
(isa start Predicate)
(arity start 1)
(arg1Isa start VisualEntity)
(comment start "Motion episode begins: the entity was at rest and starts moving.")
(isa continue Predicate)
(arity continue 1)
(arg1Isa continue VisualEntity)
(comment continue "Motion episode continues: the entity keeps moving.")
(isa end Predicate)
(arity end 1)
(arg1Isa end VisualEntity)
(comment end "Motion episode ends: the entity stops moving.")
(isa appeared Predicate)
(arity appeared 1)
(arg1Isa appeared VisualEntity)
(comment appeared "The entity became visible in the interior with no border-crossing prehistory.")
(isa reappeared Predicate)
(arity reappeared 1)
(arg1Isa reappeared VisualEntity)
(comment reappeared "A previously known entity is re-observed and re-bound to its remembered identity.")
(isa entered Predicate)
(arity entered 1)
(arg1Isa entered VisualEntity)
(comment entered "The entity crossed a viewport boundary into view (border-crossing history required).")
(isa exited Predicate)
(arity exited 1)
(arg1Isa exited VisualEntity)
(comment exited "The moving entity left through a viewport boundary, matching prior velocity.")
(isa missing Predicate)
(arity missing 1)
(arg1Isa missing VisualEntity)
(comment missing "A previously visible interior entity cannot be found; NOT evidence of destruction, exit or occlusion.")
(isa rotated Predicate)
(arity rotated 1)
(arg1Isa rotated VisualEntity)
(comment rotated "The entity's mask rotated in place with the same pixel area and colour.")
(isa color_changed Predicate)
(arity color_changed 1)
(arg1Isa color_changed VisualEntity)
(comment color_changed "Only the entity's colour changed; shape and position unchanged.")
(isa area_changed Predicate)
(arity area_changed 1)
(arg1Isa area_changed VisualEntity)
(comment area_changed "The entity's occupied pixel area changed without uniform scaling.")
(isa scaled Predicate)
(arity scaled 1)
(arg1Isa scaled VisualEntity)
(comment scaled "The entity grew or shrank uniformly about its centre. Definitional under area_changed.")
(isa shape_changed Predicate)
(arity shape_changed 1)
(arg1Isa shape_changed VisualEntity)
(comment shape_changed "The entity's mask changed to a different shape of comparable area; not a rigid rotation.")
(isa deformed Predicate)
(arity deformed 1)
(arg1Isa deformed VisualEntity)
(comment deformed "Nonuniform deformation: the mask stretched/compressed while conserving area.")
(isa hole_opened Predicate)
(arity hole_opened 1)
(arg1Isa hole_opened VisualEntity)
(comment hole_opened "An enclosed interior hole opened inside the entity; exterior bounding box unchanged.")
(isa hole_closed Predicate)
(arity hole_closed 1)
(arg1Isa hole_closed VisualEntity)
(comment hole_closed "The entity's enclosed interior hole was filled; exterior bounding box unchanged.")
(isa split Predicate)
(arity split 3)
(arg1Isa split VisualEntity)
(arg2Isa split VisualEntity)
(arg3Isa split VisualEntity)
(comment split "One connected body separated: split(source, childA, childB) with conserved total area.")
(isa merged Predicate)
(arity merged 3)
(arg1Isa merged VisualEntity)
(arg2Isa merged VisualEntity)
(arg3Isa merged VisualEntity)
(comment merged "Two bodies fused into one connected result: merged(result, sourceA, sourceB).")
(isa group_formed Predicate)
(arity group_formed 1)
(arg1Isa group_formed VisualEntityGroup)
(comment group_formed "Independent pieces joined into a coherent tracked assembly.")
(isa group_dissolved Predicate)
(arity group_dissolved 1)
(arg1Isa group_dissolved VisualEntityGroup)
(comment group_dissolved "An existing assembly separated into independent pieces.")
(isa member_added Predicate)
(arity member_added 2)
(arg1Isa member_added VisualEntityGroup)
(arg2Isa member_added VisualEntity)
(comment member_added "member_added(group, member): a piece joined an existing assembly.")
(isa member_removed Predicate)
(arity member_removed 2)
(arg1Isa member_removed VisualEntityGroup)
(arg2Isa member_removed VisualEntity)
(comment member_removed "member_removed(group, member): a member left while the assembly survives.")
(isa collision Predicate)
(arity collision 2)
(arg1Isa collision VisualEntity)
(arg2Isa collision VisualEntity)
(comment collision "Two approaching entities contacted and showed a motion response (recoil).")

;; --- Episodic relations (start/continue/end phases apply) ---
(isa contact Predicate)
(arity contact 2)
(arg1Isa contact VisualEntity)
(arg2Isa contact VisualEntity)
(comment contact "The two entities share a boundary (touching), without overlapping pixels.")
(isa attached Predicate)
(arity attached 2)
(arg1Isa attached VisualEntity)
(arg2Isa attached VisualEntity)
(comment attached "Sealed attachment: a persisting long shared edge and rigid co-movement, stronger than contact.")
(isa blocked Predicate)
(arity blocked 2)
(arg1Isa blocked VisualEntity)
(arg2Isa blocked VisualEntity)
(comment blocked "blocked(entity, obstacle): the entity's attempted movement is prevented by the obstacle it presses against. Causal: requires attempt evidence (a recorded or abduced command), not stationary contact alone.")
(isa carry Predicate)
(arity carry 2)
(arg1Isa carry VisualEntity)
(arg2Isa carry VisualEntity)
(comment carry "carry(carrier, load): a supported carrier/load relation with joint motion, not co-motion alone.")
(isa co_move Predicate)
(arity co_move 2)
(arg1Isa co_move VisualEntity)
(arg2Isa co_move VisualEntity)
(comment co_move "The two entities share the same displacement; co-motion does not imply attachment or shared identity.")
(isa follow Predicate)
(arity follow 2)
(arg1Isa follow VisualEntity)
(arg2Isa follow VisualEntity)
(comment follow "follow(follower, leader): the follower visits the leader's previous positions with a lag.")
(isa occlude Predicate)
(arity occlude 2)
(arg1Isa occlude VisualEntity)
(arg2Isa occlude VisualEntity)
(comment occlude "occlude(occluder, hidden): the occluder hides the entity; darkness/occlusion hides but never erases.")

;; --- States ---
(isa stationary Predicate)
(arity stationary 1)
(arg1Isa stationary VisualEntity)
(comment stationary "The entity did not move across the transition.")
(isa visible Predicate)
(arity visible 1)
(arg1Isa visible VisualEntity)
(comment visible "The entity is currently observed.")
(isa absent Predicate)
(arity absent 1)
(arg1Isa absent VisualEntity)
(comment absent "The entity is currently not observed (occluded or missing); absence of evidence stays unknown, not false.")

;; --- Exogenous actions ---
(isa user_input Predicate)
(arity user_input 1)
(arg1Isa user_input ARC3Command)
(comment user_input "An exogenous user command recorded in the frame's reserved state.json (or abduced when hidden). FRAME advances never assert user_input.")

;; --- Denotational functions ---
(isa tv Function-Denotational)
(resultIsa tv TruthValue)
(comment tv "tv(strength, confidence): counted-evidence truth value; contradictions lower strength instead of discarding the belief.")
(isa dxy Function-Denotational)
(resultIsa dxy Vector2D)
(comment dxy "dxy(dx, dy): pixel displacement per one-second frame step.")
(isa frame Function-Denotational)
(resultIsa frame FrameDesignator)
(comment frame "frame(N): the numbered frame a fact is asserted for.")

;; --- Belief / derivation layer ---
(isa event Predicate)
(arg1Isa event VisualEvent)
(arg2Isa event FrameDesignator)
(comment event "event(Term, frame(N)): a detected instantaneous event at frame N.")
(isa relation Predicate)
(arg1Isa relation VisualEvent)
(arg2Isa relation FrameDesignator)
(comment relation "relation(Term, frame(N)): a detected episodic relation observation at frame N.")
(isa state Predicate)
(arg1Isa state VisualEvent)
(arg2Isa state FrameDesignator)
(comment state "state(Term, frame(N)): a detected state observation at frame N.")
(isa action Predicate)
(arg1Isa action VisualEvent)
(arg2Isa action FrameDesignator)
(comment action "action(user_input(Cmd), frame(N)): the recorded exogenous input at frame N.")
(isa guess Predicate)
(arg1Isa guess VisualEvent)
(arg2Isa guess TruthValue)
(comment guess "guess(Belief, tv(S,C), support(N)): an inductive hypothesis with counted evidence; never a fact.")
(isa prediction Predicate)
(arg1Isa prediction VisualEvent)
(arg2Isa prediction FrameDesignator)
(comment prediction "prediction(Term, ...): a next-frame expectation issued from prior beliefs, later scored confirmed/refuted.")
(isa abducible Predicate)
(arg1Isa abducible EventTypeDesignator)
(arg2Isa abducible EventTypeDesignator)
(comment abducible "abducible(Hypothesis, explains(Observed), when(W)): a hidden antecedent hypothesised because a believed implication's consequent was observed without it; an explanation, never an observation.")
(isa implies Predicate)
(arg1Isa implies EventTypeDesignator)
(arg2Isa implies EventTypeDesignator)
(comment implies "implies(A, B, When): induced implication between event types with counted evidence; misses fully explained by an UNLESS precondition are excused and named.")
(isa user_action Predicate)
(arg1Isa user_action ARC3Command)
(arg2Isa user_action FrameDesignator)
(comment user_action "user_action(Command, from_frame(P), to_frame(N)): the recorded command that led into frame N.")
(isa frame_context Predicate)
(arg1Isa frame_context EventTypeDesignator)
(arg2Isa frame_context EventTypeDesignator)
(comment frame_context "frame_context(Key, Value): scalar input evidence from the frame's reserved state.json.")
